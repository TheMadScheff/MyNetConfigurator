# Kopieren nach .env.deploy und ausfüllen. .env.deploy wird nicht eingecheckt.
FTP_HOST=ftp.scheffknecht.net
FTP_USER=
FTP_PASS=
# Ordner auf dem Server, der im Web als /agroflor erscheint (je nach Hoster z. B. /agroflor/ oder /public_html/agroflor/)
FTP_DIR=/agroflor/
# ftps (verschlüsselt, Standard) oder ftp, falls der Hoster kein FTPS kann
FTP_PROTOCOL=ftps
FTP_PORT=21
# Nur für die Erfolgsmeldung
FTP_URL=https://scheffknecht.net/agroflor/
